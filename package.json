{
  "name": "f1-fantasy-scraper",
  "version": "1.0.0",
  "description": "Scrapes F1 Fantasy Tools team calculator for drivers and constructors data using Puppeteer.",
  "main": "index.js",
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "node index.js",
    "format": "prettier --write .",
    "infra:validate:runner": "az deployment group validate --resource-group \"${RESOURCE_GROUP:-f1-fantazy-bot}\" --template-file infra/runner/azuredeploy.json --parameters @infra/runner/azuredeploy.parameters.json",
    "infra:validate:scheduler": "az deployment group validate --resource-group \"${RESOURCE_GROUP:-f1-fantazy-bot}\" --template-file infra/scheduler/azuredeploy.json --parameters @infra/scheduler/azuredeploy.parameters.json",
    "infra:validate": "npm run infra:validate:runner && npm run infra:validate:scheduler",
    "infra:whatif:runner": "az deployment group what-if --resource-group \"${RESOURCE_GROUP:-f1-fantazy-bot}\" --template-file infra/runner/azuredeploy.json --parameters @infra/runner/azuredeploy.parameters.json",
    "infra:whatif:scheduler": "az deployment group what-if --resource-group \"${RESOURCE_GROUP:-f1-fantazy-bot}\" --template-file infra/scheduler/azuredeploy.json --parameters @infra/scheduler/azuredeploy.parameters.json",
    "infra:whatif": "npm run infra:whatif:runner && npm run infra:whatif:scheduler",
    "infra:deploy:runner": "az deployment group create --resource-group \"${RESOURCE_GROUP:-f1-fantazy-bot}\" --name \"scraper-runner-${DEPLOYMENT_SUFFIX:-manual-$(date +%s)}\" --template-file infra/runner/azuredeploy.json --parameters @infra/runner/azuredeploy.parameters.json",
    "infra:deploy:scheduler": "az deployment group create --resource-group \"${RESOURCE_GROUP:-f1-fantazy-bot}\" --name \"scraper-scheduler-${DEPLOYMENT_SUFFIX:-manual-$(date +%s)}\" --template-file infra/scheduler/azuredeploy.json --parameters @infra/scheduler/azuredeploy.parameters.json",
    "infra:grant-runner-msi": "bash scripts/grant-runner-msi.sh",
    "infra:deploy": "npm run infra:deploy:runner && npm run infra:grant-runner-msi && npm run infra:deploy:scheduler",
    "infra:trigger-runner": "bash scripts/trigger-runner.sh",
    "infra:logs:runner": "az monitor activity-log list --resource-group \"${RESOURCE_GROUP:-f1-fantazy-bot}\" --namespace Microsoft.Logic --max-events 20 -o table",
    "infra:status": "az resource list --resource-group \"${RESOURCE_GROUP:-f1-fantazy-bot}\" --resource-type Microsoft.Logic/workflows -o table"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@azure/data-tables": "^13.3.2",
    "@azure/storage-blob": "^12.27.0",
    "dotenv": "^16.5.0",
    "node-telegram-bot-api": "^0.66.0",
    "puppeteer": "^22.0.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.3",
    "eslint-plugin-prettier": "^5.4.0",
    "husky": "^9.1.7",
    "prettier": "^3.5.3"
  }
}
